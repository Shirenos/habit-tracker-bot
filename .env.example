# Copy to .env and fill in. NEVER commit your real token.
# Get a token from @BotFather on Telegram.
BOT_TOKEN=
# Path to the SQLite database file (the default backend)
DATABASE_PATH=data/habits.db
# IANA timezone used for "today" and reminders (e.g. Europe/Moscow, UTC)
TIMEZONE=UTC
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Comma-separated Telegram user IDs allowed to use the admin-only /admin command
# (stats: users, habits, check-ins, DB size). Leave empty to disable. Find your ID via @userinfobot.
ADMIN_IDS=

# --- Optional: PostgreSQL instead of SQLite ------------------------------------------------
# When DATABASE_URL is set it takes precedence over DATABASE_PATH. Needs `pip install .[postgres]`
# (already included in the Docker image).
# DATABASE_URL=postgresql://habits:change-me@localhost:5432/habits
# Used by docker-compose.postgres.yml for the bundled postgres service (URL-safe characters only).
# POSTGRES_PASSWORD=change-me
